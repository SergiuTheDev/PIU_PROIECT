<Window x:Class="PortfolioTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Portfolio Tracker" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Stanga: Formular Adaugare / Stergere -->
        <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,10,0">
            <StackPanel>
                <TextBlock Text="Gestionare Portofoliu" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" />

                <!-- Tip Tranzactie (RadioButtons) -->
                <TextBlock Text="Tip Tranzacție:" Margin="0,5,0,2"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <RadioButton x:Name="rbBuy" Content="Cumpărare" IsChecked="True" Margin="0,0,10,0" Checked="RbTransaction_Changed" />
                    <RadioButton x:Name="rbSell" Content="Vânzare" Checked="RbTransaction_Changed" />
                </StackPanel>

                <TextBlock Text="Simbol Activ (ex: AAPL):" Margin="0,5,0,2"/>
                <TextBox x:Name="txtSymbol" Margin="0,0,0,10" />

                <TextBlock x:Name="lblAssetName" Text="Nume Activ:" Margin="0,5,0,2"/>
                <TextBox x:Name="txtName" Margin="0,0,0,10" />

                <TextBlock x:Name="lblQuantity" Text="Cantitate:" Margin="0,5,0,2"/>
                <TextBox x:Name="txtQuantity" Margin="0,0,0,10" />

                <TextBlock x:Name="lblPrice" Text="Preț pe acțiune (USD):" Margin="0,5,0,2"/>
                <TextBox x:Name="txtPrice" Margin="0,0,0,10" />

                <!-- Checkbox pentru confirmare -->
                <CheckBox x:Name="chkConfirm" Content="Confirm datele introduse" Margin="0,5,0,15" />

                <!-- Buton Executie -->
                <Button x:Name="btnExecute" Content="Execută Tranzacția" Height="30" Click="BtnExecute_Click" />
            </StackPanel>
        </Border>

        <!-- Dreapta: DataGrid si Statistici -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Sumar Portofoliu -->
            <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Total Investit:" FontWeight="Bold"/>
                        <TextBlock x:Name="lblTotalInvested" Text="0.00 USD" FontSize="14" Foreground="DarkSlateBlue"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Valoare Curentă:" FontWeight="Bold"/>
                        <TextBlock x:Name="lblCurrentValue" Text="0.00 USD" FontSize="14" Foreground="Navy"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Profit / Pierdere:" FontWeight="Bold"/>
                        <TextBlock x:Name="lblProfitLoss" Text="0.00 USD" FontSize="14" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- DataGrid Pozitii -->
            <DataGrid x:Name="gridPositions" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Simbol" Binding="{Binding AssetDetails.Symbol}" Width="*" />
                    <DataGridTextColumn Header="Nume" Binding="{Binding AssetDetails.Name}" Width="1.5*" />
                    <DataGridTextColumn Header="Cantitate" Binding="{Binding Quantity}" Width="*" />
                    <DataGridTextColumn Header="Preț Mediu" Binding="{Binding AveragePurchasePrice, StringFormat={}{0:F2}}" Width="*" />
                    <DataGridTextColumn Header="Total Investit" Binding="{Binding TotalInvested, StringFormat={}{0:F2}}" Width="*" />
                    <DataGridTextColumn Header="P/L (%)" Binding="{Binding ProfitLossPercentage, StringFormat={}{0:F2}%}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>
