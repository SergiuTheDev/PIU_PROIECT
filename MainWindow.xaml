<Window x:Class="PortfolioTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Portfolio Tracker" Height="450" Width="800">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="BuyOnlyLabel">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBuyTransaction}" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Stanga: Formular Adaugare / Stergere -->
        <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,10,0">
            <StackPanel>
                <TextBlock Text="Gestionare Portofoliu" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" />

                <!-- Tip Tranzactie (RadioButtons) -->
                <TextBlock Text="Tip Tranzacție:" Margin="0,5,0,2"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <RadioButton Content="Cumpărare" IsChecked="{Binding IsBuyTransaction}" Margin="0,0,10,0" />
                    <RadioButton Content="Vânzare" IsChecked="{Binding IsSellTransaction}" />
                </StackPanel>

                <TextBlock Text="Simbol Activ (ex: AAPL):" Margin="0,5,0,2"/>
                <TextBox Margin="0,0,0,10" Text="{Binding Symbol, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Margin="0,5,0,2">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Cantitate (lasă gol pt. a vinde tot):" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBuyTransaction}" Value="True">
                                    <Setter Property="Text" Value="Cantitate:" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBox Margin="0,0,0,10" Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Prețul tău de achiziție (USD):" Margin="0,5,0,2" Style="{StaticResource BuyOnlyLabel}" />
                <TextBox Margin="0,0,0,10" Text="{Binding PurchasePriceText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsBuyTransaction}" />

                <!-- Checkbox pentru confirmare -->
                <CheckBox Content="Confirm datele introduse" Margin="0,5,0,15" IsChecked="{Binding IsConfirmed}" />

                <!-- Buton Executie -->
                <Button Content="Execută Tranzacția" Height="30" Command="{Binding ExecuteCommand}" />
            </StackPanel>
        </Border>

        <!-- Dreapta: DataGrid si Statistici -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Sumar Portofoliu -->
            <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Total Investit:" FontWeight="Bold"/>
                        <TextBlock Text="{Binding TotalInvested, StringFormat={}{0:F2} USD}" FontSize="14" Foreground="DarkSlateBlue"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Valoare Curentă:" FontWeight="Bold"/>
                        <TextBlock Text="{Binding CurrentValue, StringFormat={}{0:F2} USD}" FontSize="14" Foreground="Navy"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Profit / Pierdere:" FontWeight="Bold"/>
                        <TextBlock Text="{Binding ProfitLoss, StringFormat={}{0:F2} USD}" FontSize="14" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Cautare si Refresh -->
            <Grid Grid.Row="1" Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🔍 Caută:" VerticalAlignment="Center" Margin="0,0,5,0" />
                <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button Grid.Column="2" Content="🔄 Actualizează Prețurile" Width="180" Padding="5" Command="{Binding RefreshCommand}"/>
            </Grid>

            <!-- DataGrid Pozitii -->
            <DataGrid Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single" ItemsSource="{Binding PositionsView}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Simbol" Binding="{Binding AssetDetails.Symbol}" Width="*" />
                    <DataGridTextColumn Header="Nume" Binding="{Binding AssetDetails.Name}" Width="1.5*" />
                    <DataGridTextColumn Header="Cantitate" Binding="{Binding Quantity}" Width="*" />
                    <DataGridTextColumn Header="Preț Curent" Binding="{Binding AssetDetails.CurrentPrice, StringFormat={}{0:F2}}" Width="*" />
                    <DataGridTextColumn Header="Preț Mediu" Binding="{Binding AveragePurchasePrice, StringFormat={}{0:F2}}" Width="*" />
                    <DataGridTextColumn Header="Total Investit" Binding="{Binding TotalInvested, StringFormat={}{0:F2}}" Width="*" />
                    <DataGridTextColumn Header="Valoare Curentă" Binding="{Binding CurrentValue, StringFormat={}{0:F2}}" Width="*" />
                    <DataGridTextColumn Header="P/L (%)" Binding="{Binding ProfitLossPercentage, StringFormat={}{0:F2}%}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>
